  "_matching_comment": "role_keywords are matched with word boundaries + light stemming, so 'SRE' no longer matches inside other words and 'Platform Engineer' still matches 'Platform Engineering'. synonyms widen a keyword to alternate spellings (the canonical still shows in the match reason). exclude_keywords are hard drops. location_allow is substring, case-insensitive; a job with no location text is kept (ambiguous beats silently missing a match). location_exclude is checked after location_allow and knocks out region-locked remote roles (e.g. 'Remote (US)').",

  "role_keywords": [
    "MLOps", "AIOps", "ML Engineer", "Machine Learning Engineer",
    "AI Engineer", "AI/ML Engineer", "ML/AI Engineer",
    "Machine Learning Operations", "ML Platform", "AI Platform",
    "ML Infrastructure", "AI Infrastructure", "Applied ML Engineer",
    "Applied Scientist", "ML Systems", "AI Systems",
    "Site Reliability Engineer", "SRE", "DevOps Engineer",
    "Platform Engineer", "LLMOps", "LLM Engineer", "Research Engineer",
    "Forward Deployed Engineer"
  ],

  "synonyms": {
    "MLOps": ["ML Ops", "ML Operations", "Machine Learning Operations", "MLOps Engineer", "AI Ops Engineer"],
    "AIOps": ["AI Ops", "AIOps Engineer"],
    "ML Engineer": ["Machine Learning Engineer", "ML Eng", "Applied ML Engineer"],
    "AI Engineer": ["AI/ML Engineer", "ML/AI Engineer", "Artificial Intelligence Engineer", "Applied AI Engineer"],
    "ML Platform": ["ML Infrastructure", "ML Systems", "ML Frameworks", "ML Tooling"],
    "AI Platform": ["AI Infrastructure", "AI Systems", "AI Tooling"],
    "LLMOps": ["LLM Ops", "LLM Operations"],
    "LLM Engineer": ["LLM Systems", "Large Language Model Engineer"],
    "SRE": ["Site Reliability Engineer", "Site Reliability", "Reliability Engineer"],
    "Platform Engineer": ["Infrastructure Engineer", "Systems Engineer", "Production Engineer"],
    "DevOps Engineer": ["Development Operations Engineer", "Dev Ops"],
    "Research Engineer": ["Research Scientist (Eng)"],
    "Forward Deployed Engineer": ["FDE", "Forward Deployed Software Engineer"]
  },

  "exclude_keywords": [
    "intern", "internship", "unpaid", "clearance", "apprentice", "volunteer"
  ],

